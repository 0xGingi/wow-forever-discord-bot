DISCORD_TOKEN=
GUILD_ID=
# Where /apply submissions go (officers need Manage Events to accept/decline)
OFFICER_CHANNEL_ID=
# Role granted on accepted application (bot's role must sit above it)
MEMBER_ROLE_ID=
REMIND_MINUTES=30
# Ignored under Docker compose (db lives on the data volume)
DB_PATH=uwucrew.sqlite
# Category for auto-created group text/voice channels (optional)
GROUP_CATEGORY_ID=
# Hours after start before group channels are deleted (waits for voice to empty)
GROUP_TTL_HOURS=4
# --- uwucrew Sync addon ---
# Channel for automatic level-up announcements from synced characters (optional)
PROGRESS_CHANNEL_ID=
# Public HTTPS URL that reaches the bot's sync port (8787), for the companion app. Leave empty to allow only /sync paste.
SYNC_PUBLIC_URL=
SYNC_PORT=8787
# Cloudflare Tunnel (see compose.yaml): uncomment both once the tunnel exists
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
# Where players download the companion app and addon (shown by /sync link)
COMPANION_URL=
